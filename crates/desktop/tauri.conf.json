{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BirdSorter",
  "version": "0.1.0",
  "identifier": "app.birdsorter.desktop",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BirdSorter",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": [
          "cr3", "cr2", "crw", "nef", "nrw", "arw", "sr2", "srf", "orf", "raf", "rw2", "pef",
          "dng", "ari", "dcr", "dcs", "erf", "iiq", "kdc", "mef", "mos", "mrw", "nkd", "srw",
          "tfr", "x3f"
        ],
        "name": "RAW image",
        "description": "Camera RAW image",
        "role": "Editor"
      },
      {
        "ext": ["jpg", "jpeg", "tif", "tiff"],
        "name": "Photograph",
        "description": "JPEG or TIFF photograph",
        "role": "Viewer"
      }
    ],
    "resources": {
      "../../models/bird_det_v1.onnx": "models/bird_det_v1.onnx"
    }
  }
}
