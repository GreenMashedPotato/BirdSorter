{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BirdSorter",
  "version": "0.1.0",
  "identifier": "app.birdsorter.desktop",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BirdSorter",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../models/bird_det_v1.onnx": "models/bird_det_v1.onnx",
      "../../dist-models/inat21/bird_species.onnx": "models/bird_species.onnx",
      "../../dist-models/inat21/bird_species.labels.json": "models/bird_species.labels.json",
      "../../dist-models/inat21/bird_species.meta.json": "models/bird_species.meta.json"
    }
  }
}
